FROM node:22-slim

WORKDIR /app

ARG VITE_API_BASE_URL=http://127.0.0.1:8000
ARG VITE_AUTH_COOKIE_MODE=true
ARG VITE_DEMO_MODE=false
ARG VITE_DEMO_ADMIN_EMAIL=
ARG VITE_DEMO_ADMIN_PASSWORD=
ARG VITE_DEMO_OFFICER_EMAIL=
ARG VITE_DEMO_OFFICER_PASSWORD=
ARG VITE_DEMO_CITIZEN_EMAIL=
ARG VITE_DEMO_CITIZEN_PASSWORD=
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_AUTH_COOKIE_MODE=$VITE_AUTH_COOKIE_MODE
ENV VITE_DEMO_MODE=$VITE_DEMO_MODE
ENV VITE_DEMO_ADMIN_EMAIL=$VITE_DEMO_ADMIN_EMAIL
ENV VITE_DEMO_ADMIN_PASSWORD=$VITE_DEMO_ADMIN_PASSWORD
ENV VITE_DEMO_OFFICER_EMAIL=$VITE_DEMO_OFFICER_EMAIL
ENV VITE_DEMO_OFFICER_PASSWORD=$VITE_DEMO_OFFICER_PASSWORD
ENV VITE_DEMO_CITIZEN_EMAIL=$VITE_DEMO_CITIZEN_EMAIL
ENV VITE_DEMO_CITIZEN_PASSWORD=$VITE_DEMO_CITIZEN_PASSWORD
ENV VITE_APP_NAME="NiyamGuard AI"

COPY frontend/package*.json /app/
RUN npm ci

COPY frontend/ /app/
RUN npm run build

EXPOSE 5173

CMD ["npm", "run", "preview", "--", "--host", "0.0.0.0", "--port", "5173"]
